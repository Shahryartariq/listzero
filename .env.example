# Accounts and sync are optional. With none of these set, Listzero has no sign-in and keeps
# tasks in the browser only. Set them in Vercel (Project → Settings → Environment Variables),
# never in a committed file.

# Postgres. Added for you when a Neon database is connected to the Vercel project (prefix DATABASE).
# Migrations use DATABASE_URL_UNPOOLED when it is there, as Neon recommends for schema changes.
DATABASE_URL=

# A random string of at least 32 characters, e.g. the output of: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's address. On Vercel the production address is found by itself; set it to be sure.
BETTER_AUTH_URL=https://listzero.vercel.app

# Email for confirming addresses, resetting passwords and deleting accounts.
# For Gmail: the address, and an app password (Google Account → Security → App passwords).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="Listzero <you@gmail.com>"

# Sign in with Google: a web OAuth client whose redirect URI is
# https://listzero.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins when they sign up (after confirming the email).
ADMIN_EMAILS=

# PWNED_PASSWORD_CHECK=false        # skip the check against known leaked passwords
# REQUIRE_EMAIL_VERIFICATION=false  # let people sign in before confirming their email
