{
  "name": "listzero",
  "private": true,
  "version": "1.1.0",
  "description": "A free to-do list for busy minds. Capture fast, see one day at a time, get today to zero.",
  "homepage": "https://listzero.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahryartariq/listzero.git"
  },
  "bugs": {
    "url": "https://github.com/Shahryartariq/listzero/issues"
  },
  "author": "Muhammad Shehryar (https://github.com/Shahryartariq)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/pages.mjs && node scripts/build-api.mjs && node scripts/migrate.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api": "tsx watch server/local.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.25",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
